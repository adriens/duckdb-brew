# name: test/sql/brew.test
# description: test brew extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT * FROM brew_packages();
----
Catalog Error: Table Function with name brew_packages does not exist!

# Require statement will ensure this test is run with this extension loaded
require brew

# Test brew_packages() - returns 0 or more packages depending on brew availability
query I
SELECT COUNT(*) >= 0 FROM brew_packages();
----
true

# Test that we have the expected columns structure (returns 0 or 1 row)
query I
SELECT COUNT(*) >= 0 FROM (
    SELECT name, version, type, description, homepage, tap, license, installed_on_request, installed_as_dependency, installed_time 
    FROM brew_packages() 
    LIMIT 1
);
----
true

# Test brew_formulas() - returns 0 or more formulas depending on brew availability
query I
SELECT COUNT(*) >= 0 FROM brew_formulas();
----
true

# Test that all results from brew_formulas have non-null names when data exists
query I
SELECT COUNT(*) >= 0 FROM brew_formulas() WHERE name IS NOT NULL;
----
true

# Test brew_casks() - may be empty if no casks installed or brew not available
query I
SELECT COUNT(*) >= 0 FROM brew_casks();
----
true

# Test that we can query specific packages without errors
query I
SELECT COUNT(*) >= 0 FROM brew_packages() WHERE name LIKE '%duck%';
----
true

# Test that type column exists and is accessible
query I
SELECT COUNT(*) >= 0 FROM brew_packages() WHERE type IS NOT NULL OR type IS NULL;
----
true
